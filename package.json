{
  "name": "@yawlabs/electron-mcp",
  "version": "1.2.15",
  "mcpName": "io.github.YawLabs/electron-mcp",
  "description": "Electron.js MCP server — IPC scaffolding, security auditing, build tooling, and development intelligence for AI assistants",
  "license": "MIT",
  "author": "YawLabs <contact@yaw.sh>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YawLabs/electron-mcp.git"
  },
  "homepage": "https://github.com/YawLabs/electron-mcp#readme",
  "bugs": {
    "url": "https://github.com/YawLabs/electron-mcp/issues"
  },
  "keywords": [
    "electron",
    "electronjs",
    "mcp",
    "model-context-protocol",
    "ai",
    "ipc",
    "security",
    "desktop",
    "development"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "electron-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && cd dist && node --test",
    "test:ci": "npm run test",
    "smoke:published": "node scripts/smoke-published.mjs",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "prepublishOnly": "npm run build && cd dist && node --test"
  },
  "overrides": {
    "hono": "^4.12.21",
    "@hono/node-server": "^1.19.13",
    "fast-uri": "^3.1.2",
    "ip-address": "^10.2.0",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.15.2",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
  },
  "engines": {
    "node": ">=20"
  }
}
